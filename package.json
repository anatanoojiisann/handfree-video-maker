{
  "name": "capcut-handoff-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run ui\"",
    "server": "python src/server/server.py",
    "ui": "vite --host 0.0.0.0",
    "generate": "tsx src/cli/index.ts",
    "check": "tsc --noEmit",
    "install:browsers": "playwright install"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "dotenv": "^16.5.0",
    "openai": "^4.104.0",
    "playwright": "^1.54.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.19",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/node": "^22.15.21"
  }
}
