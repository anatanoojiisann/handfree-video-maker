{
  "name": "capcut-handoff-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run ui\"",
    "server": "tsx src/server/server.ts",
    "ui": "vite --host 0.0.0.0",
    "generate": "tsx src/cli/index.ts",
    "check": "tsc --noEmit",
    "install:browsers": "playwright install",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "openai": "^4.104.0",
    "playwright": "^1.54.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.19",
    "zod": "^3.25.76",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}